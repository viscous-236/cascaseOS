      "refersTo": "status-danger",
      "description": "Labelled semantic status from src/components/workspace/Status.tsx and src/index.css; static example, not a claim about the current project.",
      "html": "<span class=\"ds-state-label\"><span class=\"ds-state-dot\" aria-hidden=\"true\"></span>Payment blocked</span>",
      "css": ".ds-state-label{display:inline-flex;align-items:center;gap:6px;color:var(--red,#b43f43);font:400 12px/1.5 var(--font,Geist,system-ui,sans-serif);white-space:nowrap}.ds-state-dot{width:5px;height:5px;border-radius:50%;background:currentColor}"
