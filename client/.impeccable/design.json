      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink action from src/index.css; used by src/components/workspace/DeliveryOverview.tsx. Preview omits the optional trailing icon.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Inspect phase financials</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;padding:8px 13px;border:1px solid transparent;border-radius:var(--control-radius,6px);background:var(--primary,#24282c);color:var(--on-primary,#ffffff);font:500 13px/1.5 var(--font,Geist,system-ui,sans-serif);cursor:pointer;transition:background-color 140ms ease,color 140ms ease,transform 140ms var(--ease,cubic-bezier(.23,1,.32,1))}.ds-button-primary:hover{opacity:.9}.ds-button-primary:focus-visible{outline:2px solid var(--blue,#1d5fbf);outline-offset:3px}.ds-button-primary:active{transform:scale(.97)}.ds-button-primary:disabled{opacity:.55;cursor:not-allowed}@media(max-width:640px){.ds-button-primary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:.001ms!important}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered action from src/index.css and the overview empty-filter state in src/components/workspace/DeliveryOverview.tsx.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Clear filters</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;padding:8px 13px;border:1px solid var(--line-strong,#b9c0c6);border-radius:var(--control-radius,6px);background:var(--surface,#ffffff);color:var(--text,#202326);font:500 13px/1.5 var(--font,Geist,system-ui,sans-serif);cursor:pointer;transition:background-color 140ms ease,color 140ms ease,transform 140ms var(--ease,cubic-bezier(.23,1,.32,1))}.ds-button-secondary:hover{background:var(--surface-hover,#eceef0)}.ds-button-secondary:focus-visible{outline:2px solid var(--blue,#1d5fbf);outline-offset:3px}.ds-button-secondary:active{transform:scale(.97)}.ds-button-secondary:disabled{opacity:.55;cursor:not-allowed}@media(max-width:640px){.ds-button-secondary{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition-duration:.001ms!important}}"
    },
    {
      "name": "Icon button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Readiness selector from src/components/workspace/DeliveryOverview.tsx; ChevronRight SVG from lucide-react, styling from src/index.css.",
      "html": "<button type=\"button\" class=\"ds-button-icon\" aria-label=\"Show milestone readiness\" aria-pressed=\"false\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button>",
      "css": ".ds-button-icon{display:inline-flex;align-items:center;justify-content:center;gap:8px;flex-shrink:0;min-height:36px;width:36px;padding:0;border:1px solid transparent;border-radius:var(--control-radius,6px);background:transparent;color:var(--text-soft,#535b63);font:500 13px/1.5 var(--font,Geist,system-ui,sans-serif);cursor:pointer;transition:background-color 140ms ease,color 140ms ease,transform 140ms var(--ease,cubic-bezier(.23,1,.32,1))}.ds-button-icon:hover{background:var(--surface-hover,#eceef0)}.ds-button-icon:focus-visible{outline:2px solid var(--blue,#1d5fbf);outline-offset:3px}.ds-button-icon:active{transform:scale(.97)}.ds-button-icon:disabled{opacity:.55;cursor:not-allowed}@media(max-width:640px){.ds-button-icon{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-button-icon{transition-duration:.001ms!important}}"
    },
