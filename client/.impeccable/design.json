    {
      "name": "Recovery sheet",
      "kind": "card",
      "refersTo": "recovery-panel",
      "description": "Flat decision-panel shell from src/components/workspace/DeliveryOverview.tsx and src/index.css. Content excerpt shows the section heading and supporting-copy treatment.",
      "html": "<aside class=\"ds-recovery-panel\"><div class=\"ds-section-heading\"><h2>Milestone readiness</h2></div><p class=\"ds-rail-description\">Review payment, materials, and predecessors before changing this milestone.</p></aside>",
      "css": ".ds-recovery-panel{padding:22px;border:1px solid var(--line,#e3e6e8);border-radius:var(--radius,8px);background:var(--surface,#ffffff);color:var(--text,#202326);font:400 14px/1.5 var(--font,Geist,system-ui,sans-serif)}.ds-section-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px}.ds-section-heading h2{margin:0;font-size:16px;font-weight:500;letter-spacing:-.02em;text-wrap:balance}.ds-rail-description{margin:0;color:var(--text-muted,#626a72);font-size:13px;line-height:1.65}@media(max-width:640px){.ds-recovery-panel{padding:20px}.ds-section-heading{gap:12px;align-items:start;margin-bottom:18px}}"
