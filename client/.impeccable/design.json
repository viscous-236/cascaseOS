      "html": "<span class=\"ds-quiet-tag\">Supplier quotes</span>",
      "css": ".ds-quiet-tag{padding:4px 8px;border-radius:4px;background:var(--surface-raised,#f6f7f8);color:var(--text-soft,#535b63);font:400 12px/1.5 var(--font,Geist,system-ui,sans-serif);white-space:nowrap}"
