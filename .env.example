# =============================================================================
# CascadeOS — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git. Only commit .env.example.
# =============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/cascade_os.sqlite

# PayPal Sandbox Credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here
PAYPAL_SANDBOX_MERCHANT_EMAIL=sb-merchant@business.example.com
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer@personal.example.com

# Channel3 Product Graph API (https://paypalaihackathon.devpost.com/details/channel3)
# Hackathon promo code: PAYPAL-HACKATHON-2026 (20,000 free credits)
CHANNEL3_API_KEY=your_channel3_api_key_here
CHANNEL3_API_BASE_URL=https://api.trychannel3.com/v0

# LLM Configuration (Used for Nudge-Bot & AG Studio Agent Framework Adapter)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Frontend Vite Environment Variables (prefix with VITE_ for browser exposure)
VITE_API_BASE_URL=/api
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
VITE_AG_STUDIO_LICENSE_KEY=your_ag_studio_45_day_trial_key_here
